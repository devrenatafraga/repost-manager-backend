# Local Postgres (docker compose up -d)
DATABASE_URL=jdbc:postgresql://localhost:5432/repost
DATABASE_USER=repost
DATABASE_PASSWORD=repost

# Auth (ADR-0006)
ADMIN_EMAIL=admin@repost.local
# BCrypt hash of the admin password (quote when sourcing .env)
ADMIN_PASSWORD_HASH='REPLACE_WITH_BCRYPT_HASH'
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Optional
PORT=8080
API_BASE_URL=http://localhost:8080
COOKIE_SECURE=false
